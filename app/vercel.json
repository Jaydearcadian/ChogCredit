{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!deployments/|assets/|api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/deployments/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/price-keeper",
      "schedule": "0 6 * * *"
    }
  ],
  "functions": {
    "api/price-keeper.mjs": {
      "maxDuration": 30,
      "includeFiles": "public/deployments/monad-testnet.json"
    }
  }
}
