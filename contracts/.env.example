# Monad testnet (chain ID 10143). Keep PRIVATE_KEY out of git and out of chat.
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
PRIVATE_KEY=0xYOUR_TESTNET_ONLY_DEPLOYER_KEY
DEPLOY_MOCK_TOKENS=true

# Only used with DEPLOY_MOCK_TOKENS=false:
# USDC_ADDRESS=0x...
# COLLATERAL_TOKEN_ADDRESS=0x...

# Price is raw USDC units per 1 whole collateral token. 1e6 = $1 where USDC has 6 decimals.
COLLATERAL_PRICE_USDC_6DP=1000000
MAX_LTV_BPS=5000
LIQUIDATION_THRESHOLD_BPS=7500
ANNUAL_INTEREST_BPS=500
